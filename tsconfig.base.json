{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@org/api-client": ["./libs/shared/api-client/src/index.ts"],
      "@org/shared": ["./libs/ui/shared/src/index.ts"],
      "@org/ui-web": ["./libs/ui/web/src/index.ts"],
      "@org/ui-mobile": ["./libs/ui/mobile/src/index.ts"],
      "@librarium/types": ["./libs/shared/types/src/index.ts"],
      "@librarium/api-client": ["./libs/shared/api-client/src/index.ts"],
      "@librarium/utils": ["./libs/shared/utils/src/index.ts"],
      "@librarium/ui-shared": ["./libs/ui/shared/src/index.ts"],
      "@librarium/ui-web": ["./libs/ui/web/src/index.ts"],
      "@librarium/ui-mobile": ["./libs/ui/mobile/src/index.ts"]
    }
  }
}
